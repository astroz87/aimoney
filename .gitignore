# 환경 변수 / 비밀
.env
*.env
!.env.example

# 파이썬
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Playwright 인증 상태 저장 파일
auth_state.json
*.storage.json

# 작업 산출물 (다운로드 미디어, 가공 이미지 등)
output/
downloads/
data/

*.mp4
*.jpg
*.jpeg
*.png
!docs/**/*.png
# 확장 프로그램 아이콘은 커밋 허용
!extension/icons/*.png

# 로그
*.log
logs/

# OS / 에디터
.DS_Store
.idea/
.vscode/

# 자막 폰트 파일 (라이선스/용량 — fonts/README.md 참고)
fonts/*.ttf
fonts/*.otf
fonts/*.TTF
fonts/*.OTF

# 로컬 설치 마커 (run.bat)
.deps_installed
