# ======================================================================
# 멀티채널 숏폼 어필리에이트 자동화 시스템 환경 변수
# 이 파일을 복사하여 .env 로 저장한 뒤 실제 값을 채워주세요.
#   cp .env.example .env
# .env 파일은 절대 git 에 커밋하지 마세요 (.gitignore 에 포함됨).
#
# 참고: LLM/TTS 프로바이더·모델·키는 대시보드 설정창(/settings)에서도 관리하며,
#       DB 설정이 이 .env 값을 오버라이드합니다 (우선순위: DB > .env > 기본값).
# ======================================================================

# ----- 기본 프로바이더 선택 (설정창에서 변경 가능) -----
# LLM: mock | claude | gemini | openai   (키 없으면 자동 mock 폴백)
DEFAULT_LLM_PROVIDER=mock
# TTS: mock | edge | gemini | typecast
DEFAULT_TTS_PROVIDER=mock

# ----- Anthropic Claude -----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# ----- Google Gemini -----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ----- OpenAI (GPT) -----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ----- 링크 라우터 (트래킹 URL 베이스) -----
LINK_ROUTER_BASE=https://allmyinterest.com/go

# ----- 경로 -----
# 프로젝트 작업 데이터(SQLite/원본/tts) 저장 경로
DATA_DIR=./data
# 최종 배포 패키지 저장 경로
OUTPUT_DIR=./output

# ======================================================================
# (선택) 기존 Threads × 쿠팡 CLI 호환 설정
# ======================================================================
THREADS_USERNAME=
THREADS_PASSWORD=
COUPANG_PARTNER_TAG=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
HEADLESS=true
WORK_DIR=./output
