# ======================================================================
# Threads × Coupang Partners 자동화 CLI 환경 변수
# 이 파일을 복사하여 .env 로 저장한 뒤 실제 값을 채워주세요.
#   cp .env.example .env
# .env 파일은 절대 git 에 커밋하지 마세요 (.gitignore 에 포함됨).
# ======================================================================

# ----- Anthropic Claude API -----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 사용할 모델 (기본값: claude-opus-4-8)
CLAUDE_MODEL=claude-opus-4-8

# ----- Threads (Instagram) 로그인 계정 -----
# 콘텐츠를 발행할 "내" 스레드 계정
THREADS_USERNAME=your_threads_username
THREADS_PASSWORD=your_threads_password

# ----- 쿠팡 파트너스 -----
# 쿠팡 파트너스에서 발급받은 추적 ID (예: AF1234567)
COUPANG_PARTNER_TAG=AF1234567
# (선택) Open API 사용 시
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# ----- 동작 설정 -----
# Playwright 브라우저를 화면에 표시할지 여부 (true=표시, false=headless)
HEADLESS=true
# 다운로드/작업 결과물 저장 경로
WORK_DIR=./output
